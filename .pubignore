# What pub leaves out of the package. With this file present, pub ignores
# .gitignore here, so its rules are repeated first.

# From .gitignore:
.dart_tool/
.packages
build/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
doc/frames/
test/failures/

# Not needed to use the package (all on GitHub):
# the reels and their media (the README links them on GitHub),
doc/
# the reel recorder and its fonts,
tool/
# and CI.
.github/
